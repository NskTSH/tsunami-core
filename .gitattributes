* text=auto

# Windows toolchain files — keep CRLF
*.sln      text eol=crlf
*.vcxproj  text eol=crlf
*.vcxproj.filters text eol=crlf
*.props    text eol=crlf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Unix scripts — keep LF
*.sh       text eol=lf

# Sources — normalize to LF in the repo
*.cpp  text
*.h    text
*.hpp  text
*.cu   text
*.cuh  text
*.md   text

# Binary
*.png  binary
*.pdf  binary
*.docx binary
*.pptx binary
*.vsix binary
*.asc  binary
